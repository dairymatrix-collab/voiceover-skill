{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-provenance-envelope-v1.schema.json",
  "title": "Evidence Provenance Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_schema_version", "evidence_id", "created_at", "evidence_digest", "source", "provider", "test_environment", "artifacts", "trust_level", "verification_state", "limitations", "signature"],
  "properties": {
    "envelope_schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tool", "version", "invocation_id"],
      "properties": {
        "kind": {"enum": ["test_harness", "provider_report", "manual_import", "external_verifier"]},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "provider_version", "target_platform", "identity_claim_basis"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "target_platform": {"type": "string", "minLength": 1},
        "identity_claim_basis": {"enum": ["self_reported", "package_metadata", "independent_observation", "trusted_registry"]}
      }
    },
    "test_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["os_name", "architecture", "runtime_version", "harness_version", "started_at", "finished_at"],
      "properties": {
        "os_name": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "harness_version": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "hash_basis"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "hash_basis": {"enum": ["bytes_read_locally", "reported_by_source", "independently_recomputed"]}
        }
      }
    },
    "trust_level": {"enum": ["self_reported", "locally_measured", "independently_verified", "cryptographically_authenticated"]},
    "verification_state": {"enum": ["unverified", "partially_verified", "verified", "rejected"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_present", "not_verified", "verified", "invalid"]},
        "algorithm": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "signature_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_policy_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
