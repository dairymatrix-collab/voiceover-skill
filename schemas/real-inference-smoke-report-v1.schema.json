{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/real-inference-smoke-report-v1.schema.json",
  "title": "Real Voiceover Inference Smoke Report v1",
  "type": "object",
