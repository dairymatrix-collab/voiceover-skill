{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voiceover.local/schemas/python-runtime-acquisition-v1.schema.json",
  "type":"object",
  "required":["schema_version","diagnostic_only","installation_performed","runtime_acquired","status","probes"],
  "properties":{
    "schema_version":{"const":1},
    "diagnostic_only":{"const":true},
    "installation_performed":{"const":false},
    "runtime_acquired":{"const":false},
    "status":{"enum":["OFFLINE_RUNTIME_CANDIDATE","NO_OFFLINE_RUNTIME_AVAILABLE"]},
    "probes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/probe"}}
  },
  "additionalProperties":false,
  "$defs":{
    "probe":{
      "type":"object",
      "required":["schema_version","diagnostic_only","installation_performed","runtime_acquired","requested_version","uv_available","cache_dir","cache_dir_exists","cache_file_count","cache_truncated","status"],
      "properties":{
        "schema_version":{"const":1},"diagnostic_only":{"const":true},"installation_performed":{"const":false},"runtime_acquired":{"const":false},
        "requested_version":{"type":"string","pattern":"^3\\.(10|11|12)$"},"uv_available":{"type":"boolean"},"uv_executable":{"type":["string","null"]},"cache_dir":{"type":"string"},"cache_dir_exists":{"type":"boolean"},"cache_file_count":{"type":"integer","minimum":0},"cache_truncated":{"type":"boolean"},
        "status":{"enum":["UV_UNAVAILABLE","NOT_PROBED","OFFLINE_RUNTIME_AVAILABLE","OFFLINE_CACHE_MISS","OFFLINE_PROBE_FAILED","OFFLINE_PROBE_TIMEOUT","UV_LAUNCH_FAILED"]},"probe_exit_code":{"type":"integer"},"detail":{"type":"string"}
      },
      "additionalProperties":false
    }
  }
}
